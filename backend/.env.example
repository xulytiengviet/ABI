# Absolute path to the locally installed Gigahorse repository.
GIGAHORSE_HOME=/opt/gigahorse-toolchain
# Full analysis timeout, seconds; internal Gigahorse timeout is shorter.
ABI_ANALYSIS_TIMEOUT=110
# Optional; recommended if the API is published. Never commit a real value.
ABI_API_KEY=
# Comma-separated browser origins allowed to call the API.
ABI_ALLOWED_ORIGINS=https://xulytiengviet.github.io,http://localhost:8000,http://127.0.0.1:8000
