.output StorageVariableInfo
.output StorageVariable_Type
.output DataStructure_Type
.output Mapping_KeyType
.output DataStructure_ValueOrElementType
.output DataStructureValueIsStruct
.output StorageStmtKindAndConstruct
.output StorageStmt_HighLevelUses
